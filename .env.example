# Copy to .env and fill in whichever you have. Each key unlocks a group of models.
OPENAI_API_KEY=      # gpt-image-2.6-flare, gpt-image-2.5-flare, gpt-image-2.6-sunburst
GEMINI_API_KEY=      # gemini-3.1-flash-lite-image (Nano Banana 2 Lite), gemini-3.1-flash-image, gemini-nano-banana-2.1
FAL_KEY=             # Seedream 5.5, FLUX 3, Nano Banana via fal, etc.
